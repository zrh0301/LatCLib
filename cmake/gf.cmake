pqc_optimized_backend(PQC_GF_BACKEND "GF" avx2 gfni neon)
add_library(pqc_gf STATIC src/gf16.c src/gf16_matrix.c src/gf/common/vector.c src/gf/common/matrix.c src/gf/tower/coordinates.c)
target_include_directories(pqc_gf PUBLIC ${PROJECT_SOURCE_DIR}/inc)
if(PQC_GF_BACKEND MATCHES "^(avx2|gfni)$")
 set(gf_platform x86)
 set(gf_flags -mavx2 -mpclmul)
elseif(PQC_GF_BACKEND STREQUAL "neon")
 set(gf_platform armv8)
 set(gf_flags -march=armv8-a+crypto)
else()
 message(FATAL_ERROR "Unknown PQC_GF_BACKEND")
endif()
file(GLOB gf_sources CONFIGURE_DEPENDS src/gf/${gf_platform}/core/*.c src/gf/${gf_platform}/adapters/*.c src/gf/${gf_platform}/workloads/*.c)
# The non-GFNI packed source contains upstream placeholders, never link it.
if(NOT PQC_GF_BACKEND STREQUAL "gfni")
 list(FILTER gf_sources EXCLUDE REGEX "gf16_gfni_pack.c$")
else()
 list(APPEND gf_flags -mgfni -DGF16_ENABLE_GFNI=1)
endif()
add_library(pqc_gf_kernels OBJECT ${gf_sources} src/gf/platform_bridge.c)
target_include_directories(pqc_gf_kernels PRIVATE src/gf/${gf_platform}/internal)
target_compile_options(pqc_gf_kernels PRIVATE ${gf_flags})
target_sources(pqc_gf PRIVATE $<TARGET_OBJECTS:pqc_gf_kernels>)

if(PQC_ENABLE_SANITIZERS AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
 target_compile_options(pqc_gf PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
 target_link_options(pqc_gf PUBLIC -fsanitize=address,undefined)
endif()
