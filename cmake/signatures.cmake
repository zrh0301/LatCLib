# All new algorithm APIs are tested through Test/sig/test_signature_api.c.
target_sources(pqc_snova_r3 PRIVATE alg/snova_r3/adapter.c)

pqc_optimized_backend(PQC_SNOVA_R2_BACKEND "SNOVA R2" avx2 neon)
if(PQC_SNOVA_R2_BACKEND MATCHES "^(avx2|neon)$")
 if(PQC_SNOVA_R2_BACKEND STREQUAL "avx2")
  set(r2 alg/snova_r2/optimized/x86)
  set(r2_flags -mavx2)
 else()
  set(r2 alg/snova_r2/optimized/armv8)
  set(r2_flags -march=armv8-a+crypto)
 endif()
 set(r2_sources ${r2}/snova.c ${r2}/snova_vecops.c ${r2}/snova_transform.c ${r2}/snova_public_layout.c ${r2}/aes_armv8_crypto.c ${r2}/symmetric.c)
else()
 message(FATAL_ERROR "Unknown SNOVA R2 backend")
endif()
add_library(pqc_snova_r2 STATIC ${r2_sources} alg/snova_r2/adapter.c alg/snova_r2/randombytes.c)
target_include_directories(pqc_snova_r2 PRIVATE ${r2})
target_link_libraries(pqc_snova_r2 PUBLIC pqc)
target_compile_options(pqc_snova_r2 PRIVATE ${r2_flags})
target_compile_definitions(pqc_snova_r2 PRIVATE randombytes=pqc_snova_r2_randombytes crypto_sign=pqc_r2_crypto_sign crypto_sign_keypair=pqc_r2_crypto_sign_keypair crypto_sign_open=pqc_r2_crypto_sign_open)
target_compile_definitions(pqc_snova_r2 PRIVATE SNOVA_v=24 SNOVA_o=5 SNOVA_q=16 SNOVA_l=4 AESCTR SNOVA_OPT=_avx2 SNOVA_OFFICIAL_API_ULL SNOVA_BENCH_OWN_RANDOMBYTES SNOVA_VERIFY_DIRECT_MTK2=1 SNOVA_VERIFY_VTL=0 SNOVA_VERIFY_DIRECT_OFFICIAL=0 SNOVA_VTL_MULTTAB_LOOKUP=1)

set(PQC_MAYO_VARIANT "1" CACHE STRING "MAYO parameter: 1, 2, 3, 5")
if(NOT PQC_MAYO_VARIANT MATCHES "^(1|2|3|5)$")
 message(FATAL_ERROR "Invalid MAYO parameter")
endif()
pqc_optimized_backend(PQC_MAYO_BACKEND "MAYO" avx2 gfni neon)
set(mayo alg/mayo/common)
add_library(pqc_mayo STATIC ${mayo}/mayo.c ${mayo}/params.c ${mayo}/arithmetic.c ${mayo}/common/aes_c.c ${mayo}/common/aes128ctr.c ${mayo}/common/aes_neon.c ${mayo}/common/fips202.c ${mayo}/common/mem.c alg/mayo/adapter.c alg/mayo/randombytes.c)
target_include_directories(pqc_mayo PRIVATE alg/mayo/include ${mayo} ${mayo}/common)
target_compile_definitions(pqc_mayo PRIVATE MAYO_VARIANT=MAYO_${PQC_MAYO_VARIANT} randombytes=pqc_mayo_randombytes)
if(PQC_MAYO_BACKEND MATCHES "^(avx2|gfni)$")
 target_include_directories(pqc_mayo PRIVATE ${mayo}/AVX2)
 target_compile_definitions(pqc_mayo PRIVATE MAYO_AVX MAYO_BUILD_TYPE_AVX2)
 target_compile_options(pqc_mayo PRIVATE -mavx2)
 if(PQC_MAYO_BACKEND STREQUAL "gfni")
  target_compile_options(pqc_mayo PRIVATE -mgfni)
  target_compile_definitions(pqc_mayo PRIVATE MAYO_GF16_MATVEC MAYO_GF16_GFNI MAYO_GF16_GFNI_MULTAB MAYO_GF16_GFNI_CROSS_ROW MAYO_FUSED_SIGN_M MAYO_PACKED_SIGN_P MAYO_INPLACE_UNPACK MAYO_VECTOR_UNPACK)
 endif()
elseif(PQC_MAYO_BACKEND STREQUAL "neon")
 target_include_directories(pqc_mayo PRIVATE ${mayo}/neon)
 target_compile_definitions(pqc_mayo PRIVATE MAYO_NEON MAYO_BUILD_TYPE_NEON)
 target_compile_options(pqc_mayo PRIVATE -march=armv8-a+crypto)
else()
 message(FATAL_ERROR "Unknown MAYO backend")
endif()
target_include_directories(pqc_mayo PRIVATE ${mayo}/generic)
target_link_libraries(pqc_mayo PUBLIC pqc)

set(PQC_MQOM_SECURITY "128" CACHE STRING "MQOM security: 128, 192, 256")
set(PQC_MQOM_FIELD "4" CACHE STRING "MQOM log2 field size: 1, 2, 4, 8")
set(PQC_MQOM_ROUNDS "3" CACHE STRING "MQOM rounds: 3 or 5")
set(PQC_MQOM_TRADEOFF "0" CACHE STRING "MQOM tradeoff: 0=fast, 1=short")
if(NOT PQC_MQOM_SECURITY MATCHES "^(128|192|256)$" OR NOT PQC_MQOM_FIELD MATCHES "^(1|2|4|8)$" OR NOT PQC_MQOM_ROUNDS MATCHES "^(3|5)$" OR NOT PQC_MQOM_TRADEOFF MATCHES "^[01]$")
 message(FATAL_ERROR "Invalid MQOM parameters")
endif()
pqc_optimized_backend(PQC_MQOM_BACKEND "MQOM" avx2 gfni neon)
if(PQC_MQOM_BACKEND MATCHES "^(avx2|gfni)$")
 set(mqom alg/mqom/optimized/x86)
elseif(PQC_MQOM_BACKEND STREQUAL "neon")
 set(mqom alg/mqom/optimized/armv8)
else()
 message(FATAL_ERROR "Unknown MQOM backend")
endif()
set(mqom_sources)
foreach(f xof prg expand_mq keygen sign sign_memopt crypto_sign)
 list(APPEND mqom_sources ${mqom}/${f}.c)
endforeach()
foreach(dir rijndael ggm_tree blc piop)
 file(GLOB part CONFIGURE_DEPENDS ${mqom}/${dir}/*.c)
 list(APPEND mqom_sources ${part})
endforeach()
foreach(f KeccakHash KeccakSponge KeccakSpongetimes4 KeccakHashtimes4)
 list(APPEND mqom_sources ${mqom}/sha3/${f}.c)
endforeach()
list(APPEND mqom_sources ${mqom}/sha3/opt64/KeccakP-1600-opt64.c ${mqom}/sha3/opt64/KeccakP-1600-times4-on1.c)
add_library(pqc_mqom STATIC ${mqom_sources} alg/mqom/adapter.c alg/mqom/randombytes.c)
target_include_directories(pqc_mqom PRIVATE ${mqom} ${mqom}/sha3 ${mqom}/sha3/opt64 ${mqom}/rijndael ${mqom}/ggm_tree ${mqom}/blc ${mqom}/piop ${mqom}/fields ${mqom}/fields_bitsliced)
target_compile_definitions(pqc_mqom PRIVATE MQOM2_PARAM_SECURITY=${PQC_MQOM_SECURITY} MQOM2_PARAM_BASE_FIELD=${PQC_MQOM_FIELD} MQOM2_PARAM_NBROUNDS=${PQC_MQOM_ROUNDS} MQOM2_PARAM_TRADEOFF=${PQC_MQOM_TRADEOFF} randombytes=pqc_mqom_randombytes APPLY_NAMESPACE=latclib_mqom_ APPLY_PUBLIC_API_NAMESPACE=latclib_mqom_ RIJNDAEL_CONSTANT_TIME_REF NO_MISALIGNED_ACCESSES)
if(PQC_MQOM_BACKEND MATCHES "^(avx2|gfni)$")
 target_compile_definitions(pqc_mqom PRIVATE FIELDS_AVX2)
 target_compile_options(pqc_mqom PRIVATE -mavx2)
 if(PQC_MQOM_BACKEND STREQUAL "gfni")
  target_compile_options(pqc_mqom PRIVATE -mgfni)
 endif()
else()
 target_compile_options(pqc_mqom PRIVATE -march=armv8-a+crypto)
 target_compile_definitions(pqc_mqom PRIVATE FIELDS_NEON)
endif()
target_link_libraries(pqc_mqom PUBLIC pqc)

if(BUILD_TESTING)
 foreach(alg snova_r2 snova_r3 mayo mqom)
  add_executable(signature_${alg}_correctness Test/sig/test_signature_api.c)
  target_compile_definitions(signature_${alg}_correctness PRIVATE PQC_SIG_GETTER=pqc_${alg}_algorithm)
  target_link_libraries(signature_${alg}_correctness PRIVATE pqc_${alg})
  if(MINGW)
   target_link_options(signature_${alg}_correctness PRIVATE -Wl,--stack,16777216)
  endif()
  add_test(NAME signature_${alg}_correctness COMMAND signature_${alg}_correctness)
  set_tests_properties(signature_${alg}_correctness PROPERTIES LABELS signatures TIMEOUT 600)
 endforeach()
endif()

